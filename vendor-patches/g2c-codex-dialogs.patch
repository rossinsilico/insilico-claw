new file mode 100644
index 0000000..e57b266
--- /dev/null
+++ b/glasses/src/fleet-presentation.ts
@@ -0,0 +1,34 @@
+import type { Limit, Pane } from './api.ts'
+
+const LEVELS = '▁▂▃▄▅▆▇█'
+const level = (used: number | null) => used == null ? '·' : LEVELS[Math.min(7, Math.floor((100 - used) / 12.5))]
+const short = (label: string, agent: string) => agent === 'codex' ? 'Cx' : label.length <= 2 ? label : label.slice(0, 1).toUpperCase()
+export const usageMini = (limits: Limit[]): string => limits.map((limit) => short(limit.label, limit.agent) + [limit.session, limit.week].filter((value, index) => value != null || (index === 1 && limit.session == null)).map(level).join('')).join(' ')
+
+const GLYPH: Record<string, string> = { waiting: '!', working: '»', idle: '○', other: '·' }
+export const fleetGlyph = (pane: Pane) => pane.done ? (pane.agent === 'codex' ? '◆' : '●') : (pane.agent === 'codex' && pane.status === 'idle' ? '◇' : GLYPH[pane.status] || '·')
+export const fleetTag = (pane: Pane, preview: boolean) => {
+  const tag = preview ? (Array.from(pane.tag)[0] ?? '') : pane.tag
+  return pane.pinned ? tag.toUpperCase() : tag
+}
+
+export function fleetRows(panes: Pane[], highlighted: number, preview: boolean): string[] {
+  return [...panes.map((pane, index) => `${index === highlighted ? '▶ ' : '   '}${fleetGlyph(pane)} ${fleetTag(pane, preview)}  ${pane.label}`), `${highlighted === panes.length ? '▶ ' : '   '}＋ new session`]
+}
+
+export function fleetHeader(panes: Pane[], highlighted: number, visible: number, limits: Limit[], includeUsage: boolean): string {
+  const wait = panes.filter((pane) => pane.status === 'waiting').length
+  const work = panes.filter((pane) => pane.status === 'working').length
+  const done = panes.filter((pane) => pane.done).length
+  const idle = Math.max(0, panes.length - work - wait - done)
+  const pages = Math.max(1, Math.ceil((panes.length + 1) / visible))
+  const page = Math.min(pages, Math.floor(highlighted / visible) + 1)
+  const counts = [wait && `${wait}!`, work && `${work}»`, done && `${done}●`, idle && `${idle}○`].filter(Boolean).join(' ')
+  const usage = includeUsage ? usageMini(limits) : ''
+  return `SESSIONS ${panes.length} · p${page}/${pages}  ${counts || 'no sessions'}${usage ? `   ${usage}` : ''}`
+}
+
+export function previewLines(pane: Pane | null, busy: string, body: string[]): string[] {
+  if (!pane) return ['', '', 'New session', '──', 'Start a new Claude session', 'in a project folder.']
+  return ['', '', `${pane.tag}  ${pane.label}`, busy ? `── ${busy}…` : '──', ...(pane.status === 'waiting' ? ['! needs you — tap to read'] : []), ...body]
+}
