+
+    def test_daemon_missing_unrelated_or_ambiguous_socket_is_rejected(self):
+        uid = os.getuid()
+        socket = f'/private/tmp/codex-daemon-{uid}/' + 'a' * 64
+        client = f'p123\nccodex\nu{uid}\nf38\ntunix\nd0x111\nn->0x222\n'
+        peer = f'p456\nccodex\nu{uid}\nf40\ntunix\nd0x222\nn{socket}\n'
+        for snapshot in [client, client + peer.replace('d0x222', 'd0x333'),
+                         client + peer.replace('tunix', 'tREG'),
+                         client + peer + peer.replace('p456', 'p789'),
+                         client + peer.replace(socket, '/tmp/unrelated.sock')]:
+            with self.subTest(snapshot=snapshot), self.assertRaises(sources.SessionIdentityError):
+                self.run_with_daemon(snapshots=[snapshot])
+
+    def test_daemon_probe_permission_error_fails_closed(self):
+        with self.assertRaises(sources.SessionIdentityError):
+            self.run_with_daemon(lsof_error=True)
+
+    def test_daemon_rechecks_connection_title_and_foreground(self):
+        uid = os.getuid()
+        socket = f'/private/tmp/codex-daemon-{uid}/' + 'a' * 64
+        snapshot = (f'p123\nccodex\nu{uid}\nf38\ntunix\nd0x111\nn->0x222\n'
+                    f'p456\nccodex\nu{uid}\nf40\ntunix\nd0x222\nn{socket}\n')
+        for change in [
+            {'snapshots': [snapshot, snapshot.replace('d0x111', 'd0x999')]},
+            {'snapshots': [snapshot, snapshot.replace('p456', 'p789')]},
+            {'titles': [self.thread_title(SID), self.thread_title(OTHER)]},
+            {'process_infos': [self.info, {'process_info': {'foreground_processes': []}}]},
+        ]:
+            with self.subTest(change=change), self.assertRaises(sources.SessionIdentityError):
+                self.run_with_daemon(**change)
+
+    def test_daemon_retains_rollout_metadata_confinement_and_collision_checks(self):
+        with self.assertRaises(sources.SessionIdentityError):
+            self.run_with_daemon(paths=[self.path, self.child(COLLISION)])
+        with self.assertRaises(sources.SessionIdentityError):
+            self.run_with_daemon(paths=[])
+        with patch.object(sources, 'CODEX_SESSIONS', self.tmp.name + '/other'):
+            with self.assertRaises(sources.SessionIdentityError):
+                self.run_with_daemon()
+        self.path.write_text(json.dumps({'type': 'session_meta', 'payload': {'id': OTHER}}) + '\n')
+        with self.assertRaises(sources.SessionIdentityError):
+            self.run_with_daemon()
+
+    def test_direct_owner_does_not_consult_daemon(self):
+        self.assertEqual(self.run_with_daemon(direct_paths=[self.path], lsof_error=True)['session_id'], SID)
+
+    def test_multiple_open_rollouts_require_native_thread_title(self):
+        second = pathlib.Path(self.tmp.name) / f'rollout-second-{OTHER}.jsonl'
+        second.write_text(json.dumps({'type': 'session_meta', 'payload': {'id': OTHER}}) + '\n')
+        with self.assertRaisesRegex(RuntimeError, '/title thread-id'):
+            self.run_with_files([self.path, second])
+
+    def child(self, sid=OTHER, parent=SID, source=None):
+        path = pathlib.Path(self.tmp.name) / f'rollout-child-{sid}.jsonl'
+        payload = {'id': sid, 'source': source or {'subagent': {'other': 'guardian'}}, 'parent_thread_id': parent}
+        path.write_text(json.dumps({'type': 'session_meta', 'payload': payload}) + '\n')
