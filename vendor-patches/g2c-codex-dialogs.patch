+import assert from 'node:assert/strict'
+import test, { mock } from 'node:test'
+
+mock.module('../src/config.ts', { exports: {
+  getConfig: () => ({ base: 'https://fixture.invalid', token: 'fixture' }),
+  getProjectsDir: () => '', getOpenaiKeyPath: () => '', getSource: () => 'herdr',
+} })
+const api = await import('../src/api.ts')
+let response: Record<string, unknown> = {}
+let status = 200
+const requests: { url: string; body?: string }[] = []
+globalThis.fetch = (async (url: string, options?: RequestInit) => {
+  requests.push({ url, body: options?.body as string })
+  return { ok: status === 200, status, json: async () => response } as Response
+}) as typeof fetch
+
+test('conversation rejects another pane or missing/wrong session, including notModified', async () => {
+  for (const data of [
+    { id: 'w1:p4', session_id: 'sid-a' },
+    { id: 'w1:p2' },
+    { id: 'w1:p2', session_id: 'sid-b' },
+    { id: 'w1:p2', session_id: 'sid-b', notModified: true },
+  ]) {
+    response = data
+    await assert.rejects(api.paneConversation('w1:p2', null, { expectedSessionId: 'sid-a' }), api.SessionIdentityError)
+  }
+  response = { id: 'w1:p2', session_id: 'sid-a', turns: [], notModified: true }
+  assert.equal((await api.paneConversation('w1:p2', null, { expectedSessionId: 'sid-a' })).session_id, 'sid-a')
+})
+
+test('screen, summary and condensed reject stale identities; tmux canonical id is accepted', async () => {
+  response = { id: 'w1:p2', session_id: 'sid-b' }
+  await assert.rejects(api.paneScreen('w1:p2', 40, 'sid-a'), api.SessionIdentityError)
+  await assert.rejects(api.paneSummary('w1:p2', { expectedSessionId: 'sid-a' }), api.SessionIdentityError)
+  await assert.rejects(api.paneCondensed('w1:p2', '', 'sid-a'), api.SessionIdentityError)
+  response = { id: '%29', text: 'shell screen' }
+  assert.equal(await api.paneScreen('29'), 'shell screen')
+})
+
+test('writes include captured session id and 409 is a distinct isolation error', async () => {
+  status = 409
+  await assert.rejects(api.sendToPane('w1:p2', 'hello', true, 'sid-a'), api.SessionIdentityError)
+  assert.equal(JSON.parse(requests.at(-1)!.body!).expected_session_id, 'sid-a')
+  await assert.rejects(api.sendKeys('w1:p2', ['Enter'], 'sid-a'), api.SessionIdentityError)
+  await assert.rejects(api.paneScreen('w1:p2', 40, 'sid-a'), api.SessionIdentityError)
+  status = 200
+})
+
+test('SSE never renders a mismatched session and invalidates the view', () => {
+  class FakeEventSource {
+    onmessage: ((e: { data: string }) => void) | null = null
+    closed = false
+    url: string
+    constructor(url: string) { this.url = url }
+    close() { this.closed = true }
+  }
+  Object.assign(globalThis, { EventSource: FakeEventSource })
+  const seen: string[] = []
+  let invalidated = false
+  const stream = api.streamPane('w1:p2', text => seen.push(text), 'sid-a', () => { invalidated = true }) as unknown as FakeEventSource
+  assert.match(stream.url, /expected_session_id=sid-a/)
+  stream.onmessage!({ data: JSON.stringify({ id: 'w1:p2', session_id: 'sid-a', text: 'right' }) })
+  stream.onmessage!({ data: JSON.stringify({ id: 'w1:p4', session_id: 'sid-b', text: 'wrong' }) })
+  assert.deepEqual(seen, ['right'])
+  assert.equal(stream.closed, true)
+  assert.equal(invalidated, true)
+})
