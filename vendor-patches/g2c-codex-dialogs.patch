+class RouteTests(unittest.TestCase):
+    def setUp(self):
+        self.src = Mock()
+        self.src.list_panes.return_value = [{'pane_id': 'w1:p2', 'agent': 'codex', 'is_claude': True}]
+        self.src.pane_n.side_effect = lambda p: p['pane_id']
+        self.src.resolve_session.return_value = {'session_id': SID, 'jsonl': None, 'status': 'idle'}
+        self.src.send_text.return_value = {'pane_id': 'w1:p2'}
+        self.src.send_keys.return_value = {'pane_id': 'w1:p2'}
+        self.src.capture_pane.return_value = 'screen'
+        self.handler = api.Handler.__new__(api.Handler)
+        self.handler._authed = lambda: True
+        self.handler._source = lambda: self.src
+        self.responses = []
+        self.handler._json = lambda status, body: self.responses.append((status, body))
+
+    def post(self, route, body):
+        self.handler.path = '/api/panes/w1%3Ap2/' + route
+        self.handler._body = lambda: body
+        self.handler.do_POST()
+        return self.responses[-1]
+
+    def test_old_client_cannot_write_without_session_identity(self):
+        for route, body in [('send', {'text': 'hello'}), ('keys', {'keys': ['Enter']})]:
+            with self.subTest(route=route):
+                self.assertEqual(self.post(route, body)[0], 409)
+        self.src.send_text.assert_not_called()
+        self.src.send_keys.assert_not_called()
+
+    def test_changed_session_cannot_receive_stale_write(self):
+        self.assertEqual(self.post('send', {'text': 'hello', 'expected_session_id': OTHER})[0], 409)
+        self.src.send_text.assert_not_called()
+
+    def test_verified_session_can_receive_write(self):
+        self.assertEqual(self.post('send', {'text': 'hello', 'expected_session_id': SID})[0], 200)
+        self.src.send_text.assert_called_once()
+
+    def test_codex_replaced_by_shell_cannot_receive_stale_write(self):
+        self.src.list_panes.return_value[0]['agent'] = ''
+        self.assertEqual(self.post('send', {'text': 'hello', 'expected_session_id': SID})[0], 409)
+        self.src.send_text.assert_not_called()
+
+    def test_ordinary_shell_write_remains_unchanged(self):
+        self.src.list_panes.return_value[0]['agent'] = ''
+        self.assertEqual(self.post('send', {'text': 'hello'})[0], 200)
+        self.src.send_text.assert_called_once()
+
