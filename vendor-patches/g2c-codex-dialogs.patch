+
+    def test_native_title_selects_root_with_guardian_and_worker_open(self):
+        worker = self.child(source={'subagent': {'thread_spawn': {'parent_thread_id': SID}}})
+        guardian = self.child('bbbbbbbb-cccc-dddd-eeee-ffffffffffff', OTHER)
