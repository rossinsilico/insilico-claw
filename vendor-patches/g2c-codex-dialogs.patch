+  let cleaned = false
+  const extensions = {
+    getViewport: async () => ({ width: 576, height: 288 }),
+    addViewportListener: (next: typeof listener) => { listener = next; return () => { listener = null; cleaned = true } },
+    createLayout: async (layout: { textObject?: Array<{ height?: number; preserve?: boolean }> }, options?: { heightMode?: string }) => { calls.push({ method: 'create', height: layout.textObject?.[0]?.height ?? 0, mode: options?.heightMode, preserve: layout.textObject?.[0]?.preserve }); return true },
+    replaceLayout: async (layout: { textObject?: Array<{ height?: number; preserve?: boolean }> }, options?: { heightMode?: string }) => { calls.push({ method: 'replace', height: layout.textObject?.[0]?.height ?? 0, mode: options?.heightMode, preserve: layout.textObject?.[0]?.preserve }); return true },
+  }
+  const priorWindow = globalThis.window
+  Object.assign(globalThis, { window: { getFaceclawExtensions: () => extensions } })
+  const heights: number[] = []
+  const bridge = {
+    createStartUpPageContainer: async () => { throw new Error('stock create used') },
+    rebuildPageContainer: async () => { throw new Error('stock rebuild used') },
+  }
