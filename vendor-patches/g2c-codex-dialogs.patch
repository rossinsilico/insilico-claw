+import assert from 'node:assert/strict'
+import test from 'node:test'
+
+import { readingDelayMs } from '../src/reading-pace.ts'
+
+test('paces prose by word count while letting short headings flow sooner', () => {
+  const prose = 'one two three four five six seven eight nine ten'
+  assert.equal(readingDelayMs(prose), Math.round(10 * 60_000 / 220))
+  assert.ok(readingDelayMs('Next step') >= 600)
+  assert.ok(readingDelayMs('Next step') < 1500)
+  assert.ok(readingDelayMs(prose) > readingDelayMs('one two three four five'))
+})
+
+test('leaves a brief breath at phrase and sentence boundaries, including closing quotes', () => {
+  const prose = 'one two three four five'
+  assert.ok(readingDelayMs(prose + ',') > readingDelayMs(prose))
+  assert.ok(readingDelayMs(prose + '.') > readingDelayMs(prose + ','))
+  assert.equal(readingDelayMs(prose + '."'), readingDelayMs(prose + '.'))
+  assert.equal(readingDelayMs('version 1.2.3 is ready'), readingDelayMs('version one is ready'))
+})
+
+test('pauses at paragraph boundaries without lingering on empty spacer rows', () => {
+  assert.ok(readingDelayMs('The paragraph ends.', '') > readingDelayMs('The paragraph ends.', 'More prose'))
+  assert.ok(readingDelayMs('') >= 250)
+  assert.ok(readingDelayMs('') < readingDelayMs('A heading'))
+  assert.equal(readingDelayMs('  '), readingDelayMs(''))
+})
