+      const counts = clean[header]?.match(/^Question (\d+)\/(\d+) \(\d+ unanswered\)$/i)
+      const optionPattern = /^(›\s*)?(\d+)\.\s+(.+)$/
+      const found = clean.slice(header + 1, footer).map((line, offset) => ({ index: header + 1 + offset, match: line.match(optionPattern) })).filter((item) => item.match)
+      if (header >= 0 && counts && found.length >= 2 && found.filter(({ match }) => !!match![1]).length === 1) {
+        const first = found[0].index
+        return {
+          question: clean.slice(header + 1, first).join(' '),
+          options: found.map(({ match }) => {
+            const parts = match![3].split(/\s{2,}/, 2)
+            return { num: Number(match![2]), title: parts[0], desc: parts[1] ?? '', current: !!match![1], checked: false, free: /^None of the above$/i.test(parts[0]) }
+          }),
+          multi: false,
+          cursorIndex: Math.max(0, found.findIndex(({ match }) => !!match![1])),
+          ask: false,
+          tabCount: Number(counts[2]),
+          step: `${counts[1]}/${counts[2]}`,
+          inputOpen: /clear notes/i.test(clean[footer]),
+          kind: 'codexQuestion',
+        }
+      }
+    }
+    let queued = -1
+    for (let i = clean.length - 1; i >= 0; i--) if (/^•?\s*Queued follow-up inputs$/i.test(clean[i])) { queued = i; break }
+    if (queued < 0) return null
+    const tail = clean.slice(queued)
+    const count = tail[1]?.match(/^\?\s*(\d+) questions?\b/i)
+    const answer = tail.findIndex((line) => /^(?:⇧←|shift\s*\+?\s*left)\s+to answer$/i.test(line))
+    if (!count || answer < 0 || !tail.slice(answer + 1).every((line) => /Ask Codex to do anything|Context .* left|for agents|for shortcuts|warnings?|to view/i.test(line))) return null
+    const n = Number(count[1])
+    return {
+      question: `${n} queued question${n === 1 ? '' : 's'}`,
+      options: [{ num: 1, title: 'Review', current: true, checked: false, free: false }],
+      multi: false,
+      cursorIndex: 0,
+      ask: false,
+      tabCount: 1,
+      kind: 'codexQueued',
+    }
+  }
+
+  const tailLines = raw.map((l) => l.replace(/\x1b\[[0-9;?]*[A-Za-z]/g, '').trim()).filter(Boolean).slice(-5)
+  const footerAtBottom = /to navigate|to select|to submit|esc to cancel|\(esc\)|enter to (?:select|confirm|submit|continue|proceed)|tab\/arrow|space to (?:toggle|select)/i.test(tailLines.join('\n'))
+  const optionAtBottom = tailLines.slice(-2).some((l) => /^[│|]?\s*[❯›]?\s*\d+[.)]\s/.test(l))
+  if (!footerAtBottom && !optionAtBottom) return null
+  if (/\? for shortcuts|shift\+tab|auto-?accept edits|^[│|]\s*>|^>\s*$/im.test(tailLines.slice(-3).join('\n'))) return null
+
+  const OPT = /^\s*[│|]?\s*(❯|›|>|\*)?\s*(\d+)[.)]\s*(\[([ xX*✓✔])\]\s*)?(.+?)\s*$/
+  const isCursor = (l: string) => /^\s*[│|]?\s*[❯›]\s*\d+[.)]/.test(l)
+  let tabLine = '', tabIdx = -1
+  for (let i = raw.length - 1; i >= 0; i--) if (/\bsubmit\b/i.test(raw[i]) && /[☐☑✔]/.test(raw[i])) { tabLine = raw[i]; tabIdx = i; break }
+  const ask = !!tabLine
+  const tabCount = (tabLine.match(/[☐☑✔]/g) || []).length || 1
+  const FREE = /\btype something\b|^\s*other\s*$|^\s*custom\b/i
+  const opts: { i: number; num: number; title: string; cur: boolean; box: boolean; checked: boolean; free: boolean }[] = []
+  raw.forEach((l, i) => {
+    const m = l.match(OPT)
+    if (m && m[5] && !/^\d+(?:[.)]\d+)*\s*$/.test(m[5]) && (!ask || i > tabIdx)) opts.push({ i, num: Number(m[2]), title: m[5].trim(), cur: isCursor(l), box: !!m[3], checked: /[xX*✓✔]/.test(m[4] || ''), free: FREE.test(m[5]) })
+  })
+  if (opts.length < 2) return ask ? { question: 'review & submit', options: [], multi: false, cursorIndex: 0, ask: true, tabCount, kind: 'claudeAsk' } : null
+
+  let lo: number, hi: number
+  let ci = -1
+  for (let k = opts.length - 1; k >= 0; k--) if (opts[k].cur) { ci = k; break }
+  if (ci >= 0) {
+    lo = hi = ci
+    while (lo > 0 && opts[lo - 1].num === opts[lo].num - 1) lo--
+    while (hi < opts.length - 1 && opts[hi + 1].num === opts[hi].num + 1) hi++
+  } else {
+    if (!raw.some((l) => /to navigate|to select|✔ ?submit|esc to cancel/i.test(l))) return null
+    lo = -1
+    for (let k = opts.length - 1; k >= 0; k--) if (opts[k].num === 1) { lo = k; break }
+    if (lo < 0) return null
+    hi = lo
+    while (hi < opts.length - 1 && opts[hi + 1].num === opts[hi].num + 1) hi++
+  }
+  const block = opts.slice(lo, hi + 1)
+  if (block.length < 2) return null
+
+  let q = ''
+  if (ask) {
+    let tabI = -1
+    for (let i = opts[lo].i - 1; i >= 0; i--) if (/[☐☑✔]/.test(raw[i]) && /\bsubmit\b/i.test(raw[i])) { tabI = i; break }
+    if (tabI >= 0) q = raw.slice(tabI + 1, opts[lo].i)
+      .map((l) => l.replace(/\x1b\[[0-9;?]*[A-Za-z]/g, '').trim())
+      .filter((l) => l && !/^[\s─-╿=_·.\-]+$/.test(l))
+      .join(' ')
+  }
+  if (!q) for (let i = opts[lo].i - 1; i >= 0 && i >= opts[lo].i - 12; i--) {
+    const t = raw[i].replace(/\x1b\[[0-9;?]*[A-Za-z]/g, '').trim()
+    if (t.includes('?') && t.length > 8) { q = t.replace(/^[│|❯>›*\s]+/, ''); break }
+  }
+  return {
+    question: q,
+    options: block.map((o, k) => {
+      const endI = k + 1 < block.length ? block[k + 1].i : o.i + 4
+      const desc = raw.slice(o.i + 1, Math.min(endI, raw.length))
+        .map((l) => l.replace(/\x1b\[[0-9;?]*[A-Za-z]/g, '').replace(/^[│|\s]+/, '').trim())
+        .filter((l) => l && !/^[─\-═_·.]+$/.test(l) && !/to navigate|to select|esc to cancel|tab\/arrow|^next$|^chat about this\.?$/i.test(l) && !OPT.test(l))
+        .join(' ')
+      return { num: o.num, title: o.title, current: o.cur, checked: o.checked, free: o.free, desc }
+    }),
+    multi: block.some((o) => o.box),
+    cursorIndex: Math.max(0, block.findIndex((o) => o.cur)),
+    ask,
+    tabCount,
+    kind: ask ? 'claudeAsk' : 'claude',
+  }
+}
diff --git a/glasses/src/reading-pace.ts b/glasses/src/reading-pace.ts
new file mode 100644
index 0000000..c8c66a9
--- /dev/null
+++ b/glasses/src/reading-pace.ts
@@ -0,0 +1,11 @@
+/** One row per update: natural pauses without a character/frame animation loop. */
+export function readingDelayMs(line: string, nextLine?: string): number {
+  const text = line.trim()
+  if (!text) return 400
+  const words = text.split(/\s+/).length
+  const base = Math.max(800, Math.round(words * 60_000 / 220))
+  const sentence = /[.!?…]["'’”\])}]*$/.test(text)
+  const phrase = /[,;:]["'’”\])}]*$/.test(text)
+  const paragraph = nextLine !== undefined && !nextLine.trim()
+  return base + (sentence ? 200 : phrase ? 100 : 0) + (paragraph ? 350 : 0)
+}
diff --git a/glasses/src/typography.ts b/glasses/src/typography.ts
new file mode 100644
index 0000000..4d3f1af
--- /dev/null
+++ b/glasses/src/typography.ts
@@ -0,0 +1,140 @@
+export const STOCK_LINE_HEIGHT = 27
+
+const BLOCK_SEPARATOR = '\uE000\uE001\uE002'
+
+export type TypographyChange = { revision: number; lineHeight: number }
+export type TextMeasurement = { lineHeight?: number; revision?: number; lines?: string[] }
+export type TypographyExtensions = {
+  measureText?: (text: string, font?: undefined, options?: { maxWidth: number }) => Promise<TextMeasurement>
+  addTypographyListener?: (listener: (change: TypographyChange) => void) => () => void
+}
+
+export type PreparedTypography = {
+  groups: string[][]
+  lines: string[]
+  lineHeight: number
+  fontRevision: number
+  legacy: boolean
+}
+
+type Request = {
+  blocks: TypographyBlock[]
+  resolve: (value: PreparedTypography[] | null) => void
+}
+
+export type TypographyBlock = { logical: string[]; width: number; stockWrap: (line: string, width: number) => string[] }
+
+function flatten(groups: string[][]): string[] {
+  return groups.flatMap((group) => group.length ? group : [''])
+}
+
+function stockResult(request: TypographyBlock): PreparedTypography {
+  const groups = request.logical.map((line) => line === '' ? [''] : request.stockWrap(line, request.width))
+  return { groups, lines: flatten(groups), lineHeight: STOCK_LINE_HEIGHT, fontRevision: 0, legacy: true }
+}
+
+function encoded(logical: string[]): string {
+  return logical.flatMap((line, index) => index ? [BLOCK_SEPARATOR, line] : [line]).join('\n')
+}
+
+function decode(lines: string[], expected: number): string[][] | null {
+  const groups: string[][] = [[]]
+  for (const line of lines) {
+    if (line === BLOCK_SEPARATOR) groups.push([])
+    else groups.at(-1)!.push(line)
+  }
+  if (groups.length !== expected) return null
+  return groups.map((group) => group.length ? group : [''])
+}
+
+/**
+ * One-in-flight typography bridge. Streaming updates replace the one pending
+ * request, while callers still guard the result with their content identity.
+ */
+export class TypographyCoordinator {
+  private pending: Request | null = null
+  private running = false
+  private active = true
+  private fontRevision: number | null = null
+  private off: (() => void) | null = null
+  private readonly extensions: TypographyExtensions | null
+
+  constructor(
+    extensions: TypographyExtensions | null,
+    onFontChange: (change: TypographyChange) => void,
+  ) {
+    this.extensions = extensions
+    if (extensions?.measureText && extensions.addTypographyListener) {
+      this.off = extensions.addTypographyListener((change) => {
+        if (!this.active || !Number.isFinite(change.revision) || !Number.isFinite(change.lineHeight)) return
+        this.fontRevision = change.revision
+        onFontChange(change)
+      })
+    }
+  }
+
+  prepare(logical: string[], width: number, stockWrap: TypographyBlock['stockWrap']): Promise<PreparedTypography | null> {
+    return this.prepareComposite([{ logical, width, stockWrap }]).then((result) => result?.[0] ?? null)
+  }
+
+  prepareComposite(blocks: TypographyBlock[]): Promise<PreparedTypography[] | null> {
+    const input = blocks.slice(0, 3).map((block) => ({ ...block, logical: [...block.logical] }))
+    if (!this.active) return Promise.resolve(null)
+    if (!this.extensions?.measureText || !this.extensions.addTypographyListener) return Promise.resolve(input.map(stockResult))
+    return new Promise((resolve) => {
+      if (this.pending) this.pending.resolve(null)
+      this.pending = { blocks: input, resolve }
+      void this.pump()
+    })
+  }
+
+  dispose(): void {
+    this.active = false
+    this.off?.()
+    this.off = null
+    this.pending?.resolve(null)
+    this.pending = null
+  }
+
+  private async pump(): Promise<void> {
+    if (this.running || !this.active) return
+    const request = this.pending
+    if (!request) return
+    this.pending = null
+    this.running = true
+    let result: PreparedTypography[] | null = null
+    try {
+      result = await this.measure(request.blocks)
+    } catch {
+      result = null
+    }
+    // A newer streaming frame supersedes this result even if its identity
+    // guard would reject it later; go straight to the latest pending block.
+    if (this.pending) result = null
+    request.resolve(this.active ? result : null)
+    this.running = false
+    if (this.pending) void this.pump()
+  }
+
+  private async measure(blocks: TypographyBlock[]): Promise<PreparedTypography[]> {
+    for (let attempt = 0; attempt < 2; attempt++) {
+      const prepared: PreparedTypography[] = []
+      for (const block of blocks) {
+        if (this.pending) throw new Error('superseded')
+        const measurement = await this.extensions!.measureText!(encoded(block.logical), undefined, { maxWidth: block.width })
+        const revision = measurement.revision
+        const lineHeight = measurement.lineHeight
+        const groups = Array.isArray(measurement.lines) ? decode(measurement.lines, block.logical.length) : null
+        if (!Number.isFinite(revision) || !Number.isFinite(lineHeight) || Number(lineHeight) <= 0 || !groups) {
+          throw new Error('malformed typography measurement')
+        }
+        prepared.push({ groups, lines: flatten(groups), lineHeight: Number(lineHeight), fontRevision: Number(revision), legacy: false })
+      }
+      const revisions = new Set(prepared.filter((item) => !item.legacy).map((item) => item.fontRevision))
+      if (revisions.size > 1 || (this.fontRevision !== null && [...revisions].some((revision) => revision !== this.fontRevision))) continue
+      if (revisions.size) this.fontRevision = [...revisions][0]
+      return prepared
+    }
+    throw new Error('font changed while measuring')
+  }
+}
diff --git a/glasses/src/viewport.ts b/glasses/src/viewport.ts
new file mode 100644
index 0000000..ac08378
--- /dev/null
+++ b/glasses/src/viewport.ts
@@ -0,0 +1,83 @@
+const STOCK_HEIGHT = 288
+const LINE_HEIGHT = 27
+
+type Layout = { textObject?: Array<Record<string, unknown>> }
+type Viewport = { width: number; height: number }
+type ResponsiveExtensions = {
+  getViewport?: () => Promise<Viewport>
+  addViewportListener?: (listener: (viewport: Viewport) => void) => () => void
+  createLayout: (layout: Layout, options?: { heightMode?: 'current' }) => Promise<boolean>
+  replaceLayout: (layout: Layout, options?: { heightMode?: 'current' }) => Promise<boolean>
+}
+type LayoutBridge<T extends Layout> = {
+  createStartUpPageContainer: (layout: T) => Promise<unknown>
+  rebuildPageContainer: (layout: T) => Promise<unknown>
+}
+
+export function slotsForViewport(height: number, stockSlots: number, lineHeight = LINE_HEIGHT): number {
+  const pitch = Number.isFinite(lineHeight) && lineHeight > 0 ? lineHeight : LINE_HEIGHT
+  return Math.max(1, Math.floor((stockSlots * LINE_HEIGHT + height - STOCK_HEIGHT) / pitch))
+}
+
+export function fitLayoutToViewport<T extends Layout>(layout: T, height: number, preserve = false): T {
+  return {
+    ...layout,
+    textObject: layout.textObject?.map((container) => {
+      const y = Number(container.yPosition ?? 0)
+      const h = Number(container.height ?? 0)
+      const sized = y + h >= STOCK_HEIGHT ? { ...container, height: Math.max(1, height - y) } : container
+      return preserve ? { ...sized, preserve: true } : sized
+    }),
+  }
+}
+
+export function installResponsiveLayouts(bridge: object, onViewport: (height: number) => void): () => void {
+  const extensions = (window as unknown as { getFaceclawExtensions?: () => ResponsiveExtensions }).getFaceclawExtensions?.()
+  if (!extensions?.getViewport || !extensions.addViewportListener) return () => {}
+
+  const target = bridge as LayoutBridge<Layout>
+  const createStock = target.createStartUpPageContainer.bind(target)
+  const rebuildStock = target.rebuildPageContainer.bind(target)
+  let viewport: Viewport | null = null
+  let layout: Layout | null = null
+  let created = false
+  let active = true
+  let viewportRevision = 0
+  let queue = Promise.resolve<unknown>(true)
+  const initialRevision = viewportRevision
+  const ready = extensions.getViewport().then((value) => {
+    if (active && viewportRevision === initialRevision) { viewport = value; onViewport(value.height) }
+    return true
+  }).catch(() => false)
+  const run = (work: () => Promise<unknown>) => (queue = queue.then(work, work))
+
+  const createResponsive = (next: Layout) => run(async () => {
+    if (!await ready || !viewport) return createStock(next)
+    layout = next
+    created = true
+    return extensions.createLayout(fitLayoutToViewport(next, viewport.height), { heightMode: 'current' })
+  })
+  const rebuildResponsive = (next: Layout) => run(async () => {
+    if (!await ready || !viewport) return rebuildStock(next)
+    layout = next
+    created = true
+    return extensions.replaceLayout(fitLayoutToViewport(next, viewport.height), { heightMode: 'current' })
+  })
+
+  target.createStartUpPageContainer = createResponsive
+  target.rebuildPageContainer = rebuildResponsive
+  const stopViewport = extensions.addViewportListener((next) => {
+    if (!active) return
+    if (next.height === viewport?.height && next.width === viewport.width) return
+    viewportRevision++
+    viewport = next
+    onViewport(next.height)
+    if (created && layout) void run(() => extensions.replaceLayout(fitLayoutToViewport(layout!, next.height, true), { heightMode: 'current' }))
+  })
+  return () => {
+    active = false
+    stopViewport()
+    if (target.createStartUpPageContainer === createResponsive) target.createStartUpPageContainer = createStock
+    if (target.rebuildPageContainer === rebuildResponsive) target.rebuildPageContainer = rebuildStock
+  }
+}
