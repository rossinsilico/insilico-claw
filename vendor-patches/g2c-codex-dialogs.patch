+export interface MenuOption { num: number; title: string; current: boolean; checked: boolean; free: boolean; desc?: string }
+export interface MenuState {
+  question: string
+  options: MenuOption[]
+  multi: boolean
+  cursorIndex: number
+  ask: boolean
+  tabCount: number
+  step?: string
+  inputOpen?: boolean
+  kind: 'claude' | 'claudeAsk' | 'codexQueued' | 'codexQuestion'
+}
+
+export type MenuDisplayRow = { text: string; kind: 'opt' | 'next' | 'submit'; idx: number }
+
+/** Logical menu rows shared by layout and input so reflow cannot retarget a tap. */
+export function menuDisplayRows(menu: MenuState | null): MenuDisplayRow[] {
+  if (!menu) return []
+  const rows: MenuDisplayRow[] = menu.options.map((option, index) => ({
+    kind: 'opt', idx: index,
+    text: (menu.multi && !option.free) ? `${option.checked ? '[x]' : '[ ]'} ${option.title}` : `${option.num}. ${option.title}`,
+  }))
+  if (menu.ask) {
+    if (menu.multi && menu.options.length) rows.push({ kind: 'next', idx: -1, text: '→ next question' })
+    else if (!menu.options.length) rows.push({ kind: 'submit', idx: -1, text: '» submit answers' })
+  } else if (menu.multi) rows.push({ kind: 'submit', idx: -1, text: '» Submit' })
+  return rows
+}
+
+export const menuSignature = (menu: MenuState | null): string | null => menu
+  ? `${menu.kind}|${menu.step ?? ''}|${menu.question}|${menu.options.map((option) => `${option.num}:${option.title}:${option.current}:${option.checked}`).join(',')}`
+  : null
+
+// Cursor movement is expected during a pick; pane, step, question and options identify the reviewed target.
+export const menuTargetSignature = (menu: MenuState | null): string | null => menu
+  ? `${menu.kind}|${menu.step ?? ''}|${menu.question}|${menu.options.map((option) => option.title).join(',')}`
+  : null
+
+export function matchesMenuTarget(target: { pane: string; signature: string }, pane: string | null, signature: string | null): boolean {
+  return target.pane === pane && target.signature === signature
+}
+
+export function codexChoiceKeys(menu: MenuState, targetIndex: number, target: { pane: string; signature: string }, pane: string | null, signature: string | null): string[] | null {
+  if (menu.kind !== 'codexQuestion' || !matchesMenuTarget(target, pane, signature)) return null
+  const option = menu.options[targetIndex]
+  if (!option) return null
+  const keys = Array(Math.abs(targetIndex - menu.cursorIndex)).fill(targetIndex > menu.cursorIndex ? 'Down' : 'Up')
+  if (!option.free) keys.push('Enter')
+  else if (!menu.step?.startsWith('async')) keys.push('Tab')
+  return keys
+}
+
+export function parseMenu(raw: string[], agent: 'claude' | 'codex' = 'claude'): MenuState | null {
+  if (agent === 'codex') {
+    const clean = raw.map((line) => line.replace(/\x1b\[[0-9;?]*[A-Za-z]/g, '').trim()).filter(Boolean)
+    const footer = clean.length - 1
+    // Codex dialog footers must be the live bottom line; identical prose in scrollback is inert.
+    // Native queue navigation and narrow terminals vary/wrap the footer. Match only its bottom suffix.
+    const asyncHint = /^(?:enter submit|⌃\] skip|option \d+\/\d+|⇧→ (?:main prompt|prev question)|⇧← (?:next question|queued messages))(?:\s+(?:enter submit|⌃\] skip|option \d+\/\d+|⇧→ (?:main prompt|prev question)|⇧← (?:next question|queued messages)))*$/i
+    let footerStart = footer + 1
+    while (footerStart > 0 && asyncHint.test(clean[footerStart - 1])) footerStart--
+    const asyncFooter = clean.slice(footerStart).join(' ')
+    if (/^enter submit\s+⌃\] skip(?:\s+option \d+\/\d+)?\s+⇧→ (?:main prompt|prev question)(?:\s+⇧← (?:next question|queued messages))?$/i.test(asyncFooter)) {
+      let queued = -1
+      for (let i = footerStart - 1; i >= 0; i--) if (/^•?\s*Queued follow-up inputs$/i.test(clean[i])) { queued = i; break }
+      const optionPattern = /^(›\s*)?(\d+)\.\s+(.+)$/
+      const found = clean.slice(queued + 1, footerStart).map((line, offset) => ({ index: queued + 1 + offset, match: line.match(optionPattern) })).filter((item) => item.match)
+      const optionCount = asyncFooter.match(/option \d+\/(\d+)/i)
+      if (queued >= 0 && found.length >= 2 && found.filter(({ match }) => !!match![1]).length === 1
+        && found.every(({ match }, index) => Number(match![2]) === index + 1)
+        && (!optionCount || Number(optionCount[1]) === found.length)) {
+        const first = found[0].index
+        const progress = clean[queued + 1]?.match(/^(\d+) of (\d+)$/)
+        return {
+          question: clean.slice(queued + 1 + (progress ? 1 : 0), first).join(' '),
+          options: found.map(({ match }) => ({ num: Number(match![2]), title: match![3], current: !!match![1], checked: false, free: /^Other$/i.test(match![3]) })),
+          multi: false,
+          cursorIndex: Math.max(0, found.findIndex(({ match }) => !!match![1])),
+          ask: false,
+          tabCount: 1,
