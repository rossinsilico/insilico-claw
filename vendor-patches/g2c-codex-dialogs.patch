+  paneCondensed: async () => ({}), streamPane: () => ({ close() {} }), sendToPane: async () => {}, sendKeys: async () => {},
+  translate: async (text: string) => text, transcribe: async () => ({ text: '', cost: 0, seconds: 0 }), resolveFolder: async () => ({}),
+  newSession: async () => ({}), listWindows: async () => [], health: async () => ({ ok: true, voice: false }),
+} })
+
+const { router } = await import('../src/screens.ts')
+
+const baseState = (overrides: Partial<AppState> = {}): AppState => ({
+  panes: [], tags: [], loading: false, error: null, listSel: '', listPos: 0, preview: [], previewBusy: '',
+  activePaneN: 'pane-1', activeLabel: 'Codex', activeIsClaude: true, activeAgent: 'codex', activeSessionId: 'session-1', activeCwd: '/tmp',
+  lines: ['answer'], menu: null, menuVerified: false, menuHighlight: 0, menuPhase: 'read', menuBody: [], menuScroll: 0, menuFreeText: false,
+  scroll: 0, atBottom: true, working: true, activity: '', voiceOn: true, voiceChecked: [], canSummarize: false, canCondense: false, models: null,
+  flash: '', settingsRev: 0, viewportHeight: 288, lineHeight: 27, typographyRevision: 0, typographyLegacy: true, typographyReady: true,
+  fleetHeader: '', fleetRows: [], fleetPreview: [], fleetReady: false, menuQuestionLines: [], menuRowLines: [], limits: [], asleep: false,
+  phase: 'view', draft: '', draftKind: null, busy: false, status: '', typingText: '', draftLines: [], confirmScroll: 0, lastCost: 0, totalCost: 0,
+  newPhase: 'tag', newText: '', newTags: [], newTagIndex: 0, newTag: '', newPath: '', newCreate: false, newStatus: '', newPaneN: null,
+  ...overrides,
+})
+
+const render = (overrides: Partial<AppState> = {}) => router.toDisplayData(baseState(overrides), { screen: 'detail', highlightedIndex: 0 }).lines
+
+test('pins a short native-elapsed working footer after the scrolled reading body at every supported row budget', () => {
+  const content = Array.from({ length: 50 }, (_, index) => `answer ${index}`)
+  for (const [viewportHeight, lineHeight, footerIndex] of [[260, 27, 7], [288, 27, 9], [288, 15, 16], [452, 20, 20]] as const) {
+    const lines = render({ lines: content, scroll: 17, viewportHeight, lineHeight, activity: 'Working (1m 25s • using a tool with an arbitrarily long name)' })
+    assert.equal(lines.length, footerIndex + 1)
+    assert.equal(lines.at(-1)?.text, 'Working · 1m25s')
+    assert.equal(lines[1]?.text, 'answer 17')
+    assert.equal(lines.at(-2)?.text, `answer ${15 + footerIndex}`)
+  }
+})
+
+test('keeps the footer pinned through queued flashes, listening, transcribing, and draft review', () => {
+  const queued = render({ lines: ['reply'], flash: 'message queued', activity: 'Working 10s' })
+  assert.match(queued[0].text, /message queued/)
+  assert.equal(queued.length, 10)
+  assert.equal(queued.at(-1)?.text, 'Working · 10s')
+
+  const listening = render({ phase: 'listening', lines: ['reply'], activity: 'Thinking about the request' })
+  assert.equal(listening.length, 10)
+  assert.equal(listening.at(-1)?.text, 'Working')
+
+  const transcribing = render({ phase: 'confirm', busy: true, lines: ['first', 'second'], status: 'transcribing…', activity: 'Working 11s' })
+  assert.equal(transcribing.length, 10)
+  assert.equal(transcribing.at(-1)?.text, 'Working · 11s')
+
+  const draftLines = Array.from({ length: 12 }, (_, index) => `draft ${index}`)
+  const draft = render({ phase: 'confirm', draftLines, confirmScroll: 99, status: 'send failed', activity: 'Working 12s' })
+  assert.equal(draft.length, 10)
+  assert.equal(draft.at(-3)?.text, 'draft 11')
+  assert.equal(draft.at(-2)?.text, 'send failed')
+  assert.equal(draft.at(-1)?.text, 'Working · 12s')
+})
+
+test('gives question controls the full screen and never invents working after authoritative state ends', () => {
+  const menuBody = Array.from({ length: 20 }, (_, index) => `approval ${index}`)
+  const menu = render({
+    menu: { kind: 'claude', question: 'Approve?', options: [], cursorIndex: 0, multi: false, ask: false },
+    menuVerified: true,
+    menuBody,
+    activity: 'Working 14s',
+  })
+  assert.equal(menu.length, 10)
+  assert.equal(menu.at(-1)?.text, 'approval 8')
+  assert.ok(!menu.some((entry) => entry.text.startsWith('Working')))
+
+  const completed = render({ working: false, activity: 'Working 15s', status: 'complete' })
+  assert.ok(!completed.some((entry) => entry.text.startsWith('Working')))
+
+  const identityLost = render({ working: false, activity: 'Working 16s', status: 'session identity unavailable' })
+  assert.ok(!identityLost.some((entry) => entry.text.startsWith('Working')))
+
+  const closed = render({ activePaneN: null, working: false, activity: 'Working 17s' })
+  assert.ok(!closed.some((entry) => entry.text.startsWith('Working')))
+})
