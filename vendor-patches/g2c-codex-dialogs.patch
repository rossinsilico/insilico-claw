+
+class QuestionReceiptTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.path = pathlib.Path(self.tmp.name) / 'rollout-question.jsonl'
+        tc._convo_state.clear()
+
+    def append(self, payload):
+        with self.path.open('a') as f:
+            f.write(json.dumps({'type': 'response_item', 'payload': payload}) + '\n')
+
+    def ask(self, call_id, title='Roughly when did the ring dropouts happen?', options=None):
+        self.append({'type': 'function_call', 'name': 'request_user_input_async', 'call_id': call_id,
+                     'arguments': json.dumps({'questions': [{'title': title, 'options': options or ['During G2C trouble', 'Later']}]})})
+
+    def answer(self, call_id, title='Roughly when did the ring dropouts happen?', answer='During G2C trouble'):
+        reply = [{'answer': answer, 'question': title,
+                  'questionItemId': json.dumps(['request_user_input_async', call_id, 0])}]
+        self.append({'type': 'message', 'role': 'user', 'content': [{'type': 'input_text',
+                     'text': '<send_user_message_question_reply>\n' + json.dumps(reply) + '\n</send_user_message_question_reply>'}]})
+
+    def test_exact_reply_marks_only_its_known_question_resolved(self):
+        self.ask('call_first')
+        self.ask('call_other', title='Another question?', options=['Yes', 'No'])
+        self.answer('call_first')
+        receipts = tc.question_receipts(self.path)
+        self.assertEqual(receipts, [
+            {'call_id': 'call_first', 'index': 0, 'question': 'Roughly when did the ring dropouts happen?',
+             'options': ['During G2C trouble', 'Later'], 'resolved': True},
+            {'call_id': 'call_other', 'index': 0, 'question': 'Another question?',
+             'options': ['Yes', 'No'], 'resolved': False},
+        ])
+
+    def test_acceptance_output_and_unknown_reply_are_not_resolution_receipts(self):
+        self.ask('call_pending')
+        self.append({'type': 'function_call_output', 'call_id': 'call_pending', 'output': json.dumps({'accepted': True})})
+        self.answer('call_unknown')
+        self.assertEqual(tc.question_receipts(self.path), [
+            {'call_id': 'call_pending', 'index': 0, 'question': 'Roughly when did the ring dropouts happen?',
+             'options': ['During G2C trouble', 'Later'], 'resolved': False},
+        ])
+
+
+class OwnershipTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.path = pathlib.Path(self.tmp.name) / f'rollout-test-{SID}.jsonl'
+        self.path.write_text(json.dumps({'type': 'session_meta', 'payload': {'id': SID, 'source': 'cli'}}) + '\n')
+        self.src = sources.HerdrSource()
+        self.info = {'process_info': {'foreground_processes': [{'pid': 123, 'name': 'codex'}]}}
+        self.src._json = Mock(return_value=self.info)
+        self.pane = {'pane_id': 'w1:p2', 'agent': 'codex', '_sid': OTHER, '_agent_status': 'idle'}
+        self.patchroot = patch.object(sources, 'CODEX_SESSIONS', self.tmp.name)
+        self.patchroot.start()
+        self.addCleanup(self.patchroot.stop)
+
+    def thread_title(self, sid):
+        return sid[:29] + '...'
+
+    def run_with_files(self, paths, title='', process_infos=None, titles=None):
+        output = 'p123\n' + ''.join(f'n{p}\n' for p in paths)
+        process_infos = iter(process_infos or [self.info, self.info])
+        titles = iter(titles or [title, title])
+
+        def herdr(args):
+            if args[:2] == ['pane', 'process-info']:
+                return next(process_infos)
+            if args[:2] == ['pane', 'get']:
+                return {'pane': {'terminal_title_stripped': next(titles)}}
+            raise AssertionError(args)
+
+        self.src._json.side_effect = herdr
+        with patch.object(sources.subprocess, 'run', return_value=subprocess.CompletedProcess([], 0, output, '')):
+            return self.src.resolve_session(self.pane)
+
+    def test_open_rollout_overrides_wrong_herdr_hook_metadata(self):
+        result = self.run_with_files([self.path])
+        self.assertEqual(result['jsonl'], str(self.path.resolve()))
+        self.assertEqual(result['session_id'], SID)
+
+    def test_macos_lsof_resolves_with_minimal_service_path(self):
+        output = f'p123\nn{self.path}\n'
+        with patch.dict(os.environ, {'PATH': '/usr/bin:/bin'}):
+            with patch.object(sources.subprocess, 'run', return_value=subprocess.CompletedProcess([], 0, output, '')) as run:
+                self.assertEqual(self.src.resolve_session(self.pane)['session_id'], SID)
+                self.assertEqual(run.call_args.args[0][0], '/usr/sbin/lsof')
+
+    def test_daemon_client_with_no_open_rollout_is_rejected(self):
+        with self.assertRaisesRegex(RuntimeError, 'identity'):
+            self.run_with_files([])
+
+    def run_with_daemon(self, *, snapshots=None, paths=None, title=None, titles=None,
+                        process_infos=None, uid=None, executable=None, mode=None,
+                        lsof_error=False, direct_paths=None):
+        uid = os.getuid() if uid is None else uid
+        executable = executable or os.path.expanduser('~/.codex/packages/app-server-daemon/releases/test/bin/codex')
+        socket = f'/private/tmp/codex-daemon-{os.getuid()}/' + 'a' * 64
+        snapshot = (f'p123\nccodex\nu{os.getuid()}\nf38\ntunix\nd0x111\nn->0x222\n'
+                    f'p456\nccodex\nu{uid}\nf40\ntunix\nd0x222\nn{socket}\n')
+        snapshots = iter(snapshots or [snapshot, snapshot])
+        paths = [self.path] if paths is None else paths
+        title = self.thread_title(SID) if title is None else title
+        titles = iter(titles or [title, title])
+        process_infos = iter(process_infos or [self.info, self.info])
+
+        def herdr(args):
+            if args[:2] == ['pane', 'process-info']:
+                return next(process_infos)
+            if args[:2] == ['pane', 'get']:
+                return {'pane': {'terminal_title_stripped': next(titles)}}
+            raise AssertionError(args)
+
+        def run(args, **kwargs):
+            if '-U' in args:
+                if lsof_error:
+                    return subprocess.CompletedProcess(args, 1, '', 'permission denied')
+                output = next(snapshots)
+            elif args[0] == '/bin/ps':
+                output = (f'{uid} {executable}\n' if args[-1] == 'uid=,comm=' else
+                          f'{executable} {mode or "app-server --listen unix:// --managed-daemon"}\n')
+            elif args[args.index('-p') + 1] == '123':
+                output = 'p123\n' + ''.join(f'n{p}\n' for p in (direct_paths or []))
+            else:
+                self.assertEqual(args[args.index('-p') + 1], '456')
+                output = 'p456\n' + ''.join(f'n{p}\n' for p in paths)
+            return subprocess.CompletedProcess(args, 0, output, '')
+
+        self.src._json.side_effect = herdr
+        with patch.object(sources.subprocess, 'run', side_effect=run):
+            return self.src.resolve_session(self.pane)
+
+    def test_actual_connected_daemon_owns_selected_rollout(self):
+        result = self.run_with_daemon(paths=[self.child(), self.path])
+        self.assertEqual(result['session_id'], SID)
+        self.assertEqual(result['jsonl'], str(self.path.resolve()))
+
+    def test_daemon_supports_full_native_uuid_title(self):
+        self.assertEqual(self.run_with_daemon(title=SID)['session_id'], SID)
+
+    def test_isolated_service_home_uses_account_daemon_installation(self):
+        executable = pwd.getpwuid(os.getuid()).pw_dir + '/.codex/packages/app-server-daemon/releases/test/bin/codex'
+        with patch.dict(os.environ, {'HOME': self.tmp.name}):
