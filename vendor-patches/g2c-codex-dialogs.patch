+import assert from 'node:assert/strict'
+import test from 'node:test'
+
+import { STOCK_LINE_HEIGHT, TypographyCoordinator, type TextMeasurement, type TypographyChange } from '../src/typography.ts'
+
+const deferred = <T,>() => {
+  let resolve!: (value: T) => void
+  const promise = new Promise<T>((yes) => { resolve = yes })
+  return { promise, resolve }
+}
+const stockWrap = (line: string, width: number) => {
+  const chars = Math.max(1, width / 10)
+  return Array.from({ length: Math.ceil(line.length / chars) }, (_, index) => line.slice(index * chars, (index + 1) * chars))
+}
+
+test('coalesces streaming updates and never commits A or B after C is pending', async () => {
+  const calls: Array<ReturnType<typeof deferred<TextMeasurement>>> = []
+  let listener: ((change: TypographyChange) => void) | null = null
+  const coordinator = new TypographyCoordinator({
+    measureText: () => { const call = deferred<TextMeasurement>(); calls.push(call); return call.promise },
+    addTypographyListener: (next) => { listener = next; return () => { listener = null } },
+  }, () => {})
+  const a = coordinator.prepare(['A'], 100, stockWrap)
+  const b = coordinator.prepare(['B'], 100, stockWrap)
+  const c = coordinator.prepare(['C'], 100, stockWrap)
+  assert.equal(await b, null)
+  calls[0].resolve({ lines: ['A'], lineHeight: 15, revision: 1 })
+  assert.equal(await a, null)
+  await new Promise((resolve) => setImmediate(resolve))
+  assert.equal(calls.length, 2)
+  calls[1].resolve({ lines: ['C'], lineHeight: 15, revision: 1 })
+  assert.deepEqual(await c, { groups: [['C']], lines: ['C'], lineHeight: 15, fontRevision: 1, legacy: false })
+  coordinator.dispose()
+  assert.equal(listener, null)
+})
+
+test('retries a late initial measurement after a newer font event', async () => {
+  const calls: Array<ReturnType<typeof deferred<TextMeasurement>>> = []
+  let listener: ((change: TypographyChange) => void) | null = null
+  const changes: TypographyChange[] = []
+  const coordinator = new TypographyCoordinator({
+    measureText: () => { const call = deferred<TextMeasurement>(); calls.push(call); return call.promise },
+    addTypographyListener: (next) => { listener = next; return () => {} },
+  }, (change) => changes.push(change))
+  const pending = coordinator.prepare(['latest'], 100, stockWrap)
+  listener?.({ revision: 2, lineHeight: 20 })
+  calls[0].resolve({ lines: ['stale'], lineHeight: 15, revision: 1 })
+  await new Promise((resolve) => setImmediate(resolve))
+  calls[1].resolve({ lines: ['latest'], lineHeight: 20, revision: 2 })
+  assert.deepEqual(await pending, { groups: [['latest']], lines: ['latest'], lineHeight: 20, fontRevision: 2, legacy: false })
+  assert.deepEqual(changes, [{ revision: 2, lineHeight: 20 }])
+})
+
+test('keeps exact stock wrapping when the host lacks the new contract', async () => {
+  const coordinator = new TypographyCoordinator({ measureText: async () => ({ lineHeight: 15 }) }, () => {})
+  assert.deepEqual(await coordinator.prepare(['123456'], 30, stockWrap), {
+    groups: [['123', '456']], lines: ['123', '456'], lineHeight: STOCK_LINE_HEIGHT, fontRevision: 0, legacy: true,
+  })
+})
+
+test('fails closed when an advertised typography contract returns malformed metrics', async () => {
+  const coordinator = new TypographyCoordinator({
+    measureText: async () => ({ lineHeight: 15 }),
+    addTypographyListener: () => () => {},
+  }, () => {})
+  assert.equal(await coordinator.prepare(['approval text'], 100, stockWrap), null)
+})
+
+test('preserves logical line groups while using host-wrapped rows', async () => {
+  const coordinator = new TypographyCoordinator({
+    measureText: async (text) => ({
+      lines: text.split('\n').flatMap((line) => line === 'alpha beta' ? ['alpha', 'beta'] : [line]),
+      lineHeight: 16,
+      revision: 4,
+    }),
+    addTypographyListener: () => () => {},
+  }, () => {})
+  const result = await coordinator.prepare(['alpha beta', '', 'gamma'], 80, stockWrap)
+  assert.deepEqual(result, {
+    groups: [['alpha', 'beta'], [''], ['gamma']],
+    lines: ['alpha', 'beta', '', 'gamma'],
+    lineHeight: 16,
+    fontRevision: 4,
+    legacy: false,
+  })
+})
