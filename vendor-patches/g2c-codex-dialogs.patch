+  await bridge.createStartUpPageContainer({ textObject: [{ yPosition: 0, height: 288 }] })
+  listener?.({ width: 576, height: 452 })
+  await new Promise((resolve) => setTimeout(resolve, 0))
+  await bridge.rebuildPageContainer({ textObject: [{ yPosition: 0, height: 288 }] })
+  listener?.({ width: 576, height: 288 })
+  await new Promise((resolve) => setTimeout(resolve, 0))
+  await bridge.rebuildPageContainer({ textObject: [{ yPosition: 0, height: 288 }] })
+  assert.deepEqual(calls, [
+    { method: 'create', height: 288, mode: 'current', preserve: undefined },
+    { method: 'replace', height: 452, mode: 'current', preserve: true },
+    { method: 'replace', height: 452, mode: 'current', preserve: undefined },
+    { method: 'replace', height: 288, mode: 'current', preserve: true },
+    { method: 'replace', height: 288, mode: 'current', preserve: undefined },
+  ])
+  assert.deepEqual(heights, [288, 452, 288])
+  cleanup()
+  assert.equal(cleaned, true)
+  await assert.rejects(bridge.createStartUpPageContainer({ textObject: [{ height: 288 }] }), /stock create used/)
+  Object.assign(globalThis, { window: priorWindow })
+});
+
+test('a resize event wins over an older viewport request that resolves later', async () => {
+  let resolveViewport!: (viewport: { width: number; height: number }) => void
+  let listener: ((viewport: { width: number; height: number }) => void) | null = null
+  const calls: number[] = []
+  const extensions = {
+    getViewport: () => new Promise<{ width: number; height: number }>((resolve) => { resolveViewport = resolve }),
+    addViewportListener: (next: typeof listener) => { listener = next; return () => { listener = null } },
+    createLayout: async (layout: { textObject?: Array<{ height?: number }> }) => { calls.push(layout.textObject?.[0]?.height ?? 0); return true },
+    replaceLayout: async () => true,
+  }
+  const priorWindow = globalThis.window
+  Object.assign(globalThis, { window: { getFaceclawExtensions: () => extensions } })
+  const heights: number[] = []
+  const bridge = { createStartUpPageContainer: async () => true, rebuildPageContainer: async () => true }
+  installResponsiveLayouts(bridge, (height) => heights.push(height))
+  const create = bridge.createStartUpPageContainer({ textObject: [{ yPosition: 0, height: 288 }] })
+  listener?.({ width: 576, height: 452 })
+  resolveViewport({ width: 576, height: 288 })
+  await create
+  assert.deepEqual(calls, [452])
+  assert.deepEqual(heights, [452])
+  Object.assign(globalThis, { window: priorWindow })
+});
+
+test('stock hosts keep the original create and rebuild path', async () => {
+  const priorWindow = globalThis.window
+  Object.assign(globalThis, { window: {} })
+  const calls: Array<{ method: string; height: number }> = []
+  const bridge = {
+    createStartUpPageContainer: async (layout: { textObject?: Array<{ height?: number }> }) => { calls.push({ method: 'create', height: layout.textObject?.[0]?.height ?? 0 }); return true },
+    rebuildPageContainer: async (layout: { textObject?: Array<{ height?: number }> }) => { calls.push({ method: 'rebuild', height: layout.textObject?.[0]?.height ?? 0 }); return true },
+  }
+  installResponsiveLayouts(bridge, () => { throw new Error('stock viewport callback used') })
+  await bridge.createStartUpPageContainer({ textObject: [{ height: 288 }] })
+  await bridge.rebuildPageContainer({ textObject: [{ height: 288 }] })
+  assert.deepEqual(calls, [{ method: 'create', height: 288 }, { method: 'rebuild', height: 288 }])
+  Object.assign(globalThis, { window: priorWindow })
+});
