+import assert from 'node:assert/strict'
+import test from 'node:test'
+import { codexChoiceKeys, matchesMenuTarget, parseMenu } from '../src/menu.ts'
+
+const lines = (text: string) => text.trim().split('\n')
+
+test('offers Review for a live queued Codex question', () => {
+  const menu = parseMenu(lines(`
+• Working (11m 00s • esc to interrupt)
+
+• Queued follow-up inputs
+  ? 1 question · 12s
+    ⇧← to answer
+
+» Ask Codex to do anything
+  GPT-6.1-Sol ultra · Context 44% left · Main [default]
+  ← for agents · ? for shortcuts
+  `), 'codex')
+
+  assert.equal(menu?.kind, 'codexQueued')
+  assert.equal(menu?.question, '1 queued question')
+  assert.deepEqual(menu?.options.map((option) => option.title), ['Review'])
+})
+
+test('rejects quoted queued-question prose in Codex scrollback', () => {
+  const menu = parseMenu(lines(`
+• I found text saying:
+  Queued follow-up inputs
+  ? 1 question · 12s
+  ⇧← to answer
+
+• Finished reviewing the parser.
+
+» Ask Codex to do anything
+  GPT-6.1-Sol ultra · Context 44% left · Main [default]
+  ← for agents · ? for shortcuts
+  `), 'codex')
+
+  assert.equal(menu, null)
+})
+
+test('parses an opened native Codex question and its cursor', () => {
+  const menu = parseMenu(lines(`
+Question 1/2 (2 unanswered)
+Which test color?
+
+› 1. Amber (Recommended)  Use Amber.
+  2. Blue                 Use Blue.
+  3. Green                Use Green.
+  4. None of the above    Optionally, add details in notes (tab)
+
+tab to add notes | enter to submit answer | ←/→ to navigate questions | esc to interrupt
+  `), 'codex')
+
+  assert.equal(menu?.kind, 'codexQuestion')
+  assert.equal(menu?.question, 'Which test color?')
+  assert.equal(menu?.cursorIndex, 0)
+  assert.equal(menu?.step, '1/2')
+  assert.equal(menu?.tabCount, 2)
+  assert.deepEqual(menu?.options.map((option) => option.title), [
+    'Amber (Recommended)', 'Blue', 'Green', 'None of the above',
+  ])
+  assert.equal(menu?.options[3]?.free, true)
+})
+
+test('parses the final Codex question and its submit-all footer', () => {
+  const menu = parseMenu(lines(`
+Question 2/2 (1 unanswered)
+Which test shape?
+› 1. Circle (Recommended)  Use Circle.
+  2. Square                Use Square.
+  3. Triangle              Use Triangle.
+  4. None of the above     Optionally, add details in notes (tab)
+tab to add notes | enter to submit all | ←/→ to navigate questions | esc to interrupt
+  `), 'codex')
+
+  assert.equal(menu?.kind, 'codexQuestion')
+  assert.equal(menu?.question, 'Which test shape?')
+  assert.equal(menu?.step, '2/2')
+})
+
